# 同步间隔（分钟）
SYNC_INTERVAL_MINUTES=10
# 自动补拉间隔（分钟）：把已验证选手补进缺失的群（含新增群）；0 = 禁用
BACKFILL_INTERVAL_MINUTES=30
# 管理员 open_id（逗号分隔），可使用管理指令（兜底；正常以应用协作者为准）
ADMIN_OPEN_IDS=
# 测试收件人：实发测试卡片/消息的目标 open_id（默认发给协作者里的 Lynn）
TEST_OPEN_ID=ou_d0f11d1a334e899fba7f5aae52049cc9
# 是否允许企业外用户使用机器人（1=允许；外部用户无法读取手机号，验证流程不可用）
ALLOW_EXTERNAL_USERS=0
